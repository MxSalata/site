{
  "name": "mxsalata-site",
  "compatibility_date": "2026-10-29",
  // One address only: mxsalata.com and www (custom domains, added in the dashboard; a deploy leaves them as they are).
  // Without these two lines every deploy turns the workers.dev address and Preview URLs back on.
  "workers_dev": false,
  "preview_urls": false,
  // Workers Logs record the Worker's own code running, and this Worker has none: the files are served directly.
  "observability": {
    "enabled": false,
    "logs": { "enabled": false },
    "traces": { "enabled": false }
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
