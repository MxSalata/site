---
import { getCollection } from 'astro:content';
import { SITE } from '../lib/site';

const hasWriting = (await getCollection('writing', ({ data }) => !data.draft)).length > 0;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <p>&copy; {year} {SITE.name} &middot; No trackers, no cookies.</p>
    <ul>
      <li><a href="/how-its-built/">How it's built</a></li>
      {hasWriting && <li><a href="/rss.xml">RSS</a></li>}
    </ul>
  </div>
</footer>
