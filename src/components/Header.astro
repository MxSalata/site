---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const hasWriting = (await getCollection('writing', ({ data }) => !data.draft)).length > 0;
const nav = [
  { href: '/projects/', label: 'Projects' },
  ...(hasWriting ? [{ href: '/writing/', label: 'Writing' }] : []),
  { href: '/minecraft/', label: 'Games', lock: true },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const themes = [
  { value: 'light', label: 'Light' },
  { value: 'pastel', label: 'Pastel' },
  { value: 'dark', label: 'Dark' },
  { value: 'auto', label: 'Auto' },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a class="mark" href="/" aria-current={path === '/' ? 'page' : undefined}><Icon name="mark" class="" />mxsalata</a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.lock && <Icon name="lock" label="for friends" />}
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="themes" role="group" aria-label="Theme">
      {themes.map((t) => <button type="button" data-value={t.value} aria-pressed="false">{t.label}</button>)}
    </div>
  </div>
</header>
