---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import Shot from './Shot.astro';
import { isPlaced } from '../lib/site';

interface Props {
  project: CollectionEntry<'projects'>;
  span: 2 | 3 | 4 | 6;
  tint: 'a' | 'b' | 'c';
  /** Text beside the picture, for the lead tile. */
  wide?: boolean;
  /** Title, summary and link only: the "More projects" tiles at the foot of a project page. */
  compact?: boolean;
}
const { project, span, tint, wide = false, compact = false } = Astro.props;
const { title, summary, award, pins, cover, tags } = project.data;
const href = `/projects/${project.id}/`;
// Tiles use the clean tile picture when there is one (the full-size images carry a corner credit).
// With themed set, the tile picture also comes in -pastel and -dark (Shot.astro).
const picture = !compact && cover && { src: cover.tile ?? cover.src, alt: cover.alt, under: Boolean(cover.tile) && !wide, themed: Boolean(cover.themed) };
---

<li class={`tile tint-${tint} span-${span}${wide ? ' wide' : ''}`}>
  <div class="body">
    {
      award && (
        <div class="kicker">
          <span class={isPlaced(award) ? 'badge ok' : 'badge'}>{award}</span>
          {pins?.map((pin) => (
            <span class="badge ok pin">
              <Icon name="medal" />
              {pin}
            </span>
          ))}
        </div>
      )
    }
    {compact ? <h3><a href={href}>{title}</a></h3> : <h2><a href={href}>{title}</a></h2>}
    <p>{summary}</p>
    {compact && <p class="more-link">Read about {title} <span aria-hidden="true">→</span></p>}
    {!compact && (wide || span >= 3) && <ul class="tags">{tags.slice(0, 4).map((t) => <li>{t}</li>)}</ul>}
  </div>
  {picture && <Shot class={picture.under ? 'shot under' : 'shot'} src={picture.src} alt={picture.alt} themed={picture.themed} sizes="(max-width: 52rem) 100vw, 40rem" />}
</li>
