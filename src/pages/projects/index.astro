---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectTile from '../../components/ProjectTile.astro';
import { projectOrder } from '../../lib/site';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(projectOrder);
---

<Base title="Open-sourced projects for InterSystems IRIS" description="Open-sourced projects by Mikolaj Salata for InterSystems IRIS and healthcare integration.">
  <div class="page-head">
    <p class="eyebrow">Projects</p>
    <h1>Open-sourced projects for InterSystems IRIS</h1>
    <p class="lead">Portals and fixers for healthcare integration, and the stories behind them.</p>
  </div>
  {
    projects.length === 0 ? (
      <p class="muted">Projects are on their way.</p>
    ) : (
      <ul class="bento">
        {projects.map((p, i) => <ProjectTile project={p} span={3} tint={(['a', 'b', 'c'] as const)[i % 3]} />)}
      </ul>
    )
  }
</Base>
