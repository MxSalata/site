---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate } from '../../lib/site';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Projects" description="Projects by Mikolaj Salata.">
  <h1>Projects</h1>
  {
    projects.length === 0 ? (
      <p class="muted">Projects are on their way.</p>
    ) : (
      <ul class="list">
        {projects.map((p) => (
          <li>
            <a class="card" href={`/projects/${p.id}/`}>
              <h3>{p.data.title}</h3>
              <p>{p.data.summary}</p>
              <p class="meta">{formatDate(p.data.date)}</p>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Base>
