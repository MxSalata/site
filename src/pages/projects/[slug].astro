---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectTile from '../../components/ProjectTile.astro';
import Icon from '../../components/Icon.astro';
import { formatDate, projectOrder } from '../../lib/site';

export async function getStaticPaths() {
  const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(projectOrder);
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, others: projects.filter((p) => p.id !== entry.id).slice(0, 2) },
  }));
}

const { entry, others } = Astro.props;
const { Content } = await render(entry);
const { title, summary, date, tags, links, award, contest } = entry.data;
---

<Base title={title} description={summary}>
  <div class="page-head">
    <div class="kicker">
      {award && <span class={/place/i.test(award) ? 'badge ok' : 'badge'}>{award}</span>}
      <span class="meta">{formatDate(date)}</span>
    </div>
    <h1>{title}</h1>
    <p class="lead">{summary}</p>
    {
      contest && (
        <p class="contest">
          <Icon name="star" /> <a href={contest.href}>{contest.name}</a>
        </p>
      )
    }
    <ul class="tags">{tags.map((t) => <li>{t}</li>)}</ul>
    {
      links && (
        <ul class="actions">
          {links.map((l, i) => (
            <li>
              <a class={i === 0 ? 'btn primary' : 'btn ghost'} href={l.href}>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
  <article class="paper">
    <div class="prose"><Content /></div>
  </article>
  {
    others.length > 0 && (
      <section>
        <h2 class="section-title">More projects</h2>
        <ul class="bento">
          {others.map((p, i) => (
            <ProjectTile project={p} span={3} tint={i % 2 ? 'c' : 'b'} compact />
          ))}
        </ul>
      </section>
    )
  }
</Base>
