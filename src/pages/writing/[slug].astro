---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate } from '../../lib/site';

export async function getStaticPaths() {
  // Articles published elsewhere (url) have no page here.
  const posts = await getCollection('writing', ({ data }) => !data.draft && !data.url);
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.summary} canonical={entry.data.canonical}>
  <div class="page-head">
    <p class="eyebrow">Writing &middot; {formatDate(entry.data.date)}</p>
    <h1>{entry.data.title}</h1>
    <p class="lead">{entry.data.summary}</p>
    {
      entry.data.canonical && (
        <p class="meta">
          First published at <a href={entry.data.canonical}>{new URL(entry.data.canonical).hostname}</a>.
        </p>
      )
    }
  </div>
  <article class="paper">
    <div class="prose"><Content /></div>
  </article>
</Base>
