---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, writingHref } from '../../lib/site';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Writing" description="Articles by Mikolaj Salata." noindex={posts.length === 0}>
  <div class="page-head">
    <p class="eyebrow">Writing</p>
    <h1>Notes and articles</h1>
    <p class="lead">The thinking behind the projects: design notes, trade-offs and what went wrong.</p>
  </div>
  {
    posts.length === 0 ? (
      <div class="paper">
        <p class="muted">Nothing here yet.</p>
      </div>
    ) : (
      <ul class="bento">
        {posts.map((w) => (
          <li class="tile tinted span-3">
            <p class="meta">{formatDate(w.data.date)}{w.data.url && <Fragment> &middot; {new URL(w.data.url).hostname}</Fragment>}</p>
            <h2>
              <a href={writingHref(w)}>{w.data.title}</a>
            </h2>
            <p>{w.data.summary}</p>
          </li>
        ))}
      </ul>
    )
  }
</Base>
