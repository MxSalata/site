---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE, formatDate } from '../lib/site';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const featured = projects.filter((p) => p.data.featured);
const shown = featured.length ? featured : projects.slice(0, 3);
const writing = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base title={`${SITE.name}, healthcare integration engineer`} description={SITE.description}>
  <div class="hero">
    <img class="avatar" src="/images/mikolaj-salata.jpg" alt="Photo of Mikolaj Salata" width="120" height="120" />
    <div>
      <h1>{SITE.name}</h1>
      <p class="role">Healthcare integration engineer: HL7, FHIR and InterSystems IRIS for NHS hospitals</p>
      <p class="lead">I connect hospital systems so that the people caring for patients have the information they need.</p>
      <ul class="links actions">
        <li><a class="button" href="/cv.pdf">Download my CV</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/about/">About me</a></li>
        <li><a href={SITE.linkedin} rel="me">LinkedIn</a></li>
        <li><a href={SITE.github} rel="me">GitHub</a></li>
      </ul>
    </div>
  </div>

  {
    shown.length > 0 && (
      <section>
        <h2>Projects</h2>
        <ul class="list">
          {shown.map((p) => (
            <li>
              <a class="card" href={`/projects/${p.id}/`}>
                <h3>{p.data.title}</h3>
                <p>{p.data.summary}</p>
              </a>
            </li>
          ))}
        </ul>
        <p>
          <a href="/projects/">All projects</a>
        </p>
      </section>
    )
  }

  {
    writing.length > 0 && (
      <section>
        <h2>Writing</h2>
        <ul class="list">
          {writing.map((w) => (
            <li>
              <a class="card" href={`/writing/${w.id}/`}>
                <h3>{w.data.title}</h3>
                <p class="meta">{formatDate(w.data.date)}</p>
              </a>
            </li>
          ))}
        </ul>
        <p>
          <a href="/writing/">All writing</a>
        </p>
      </section>
    )
  }
</Base>
