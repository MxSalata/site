---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProjectTile from '../components/ProjectTile.astro';
import { SITE, projectOrder, bookingHref } from '../lib/site';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(projectOrder);
const featured = projects.filter((p) => p.data.featured);
const shown = featured.length ? featured : projects.slice(0, 3);
const reviews = (await getCollection('reviews', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title={`${SITE.name}: interoperability solutions for NHS hospitals, councils and clinics`} description={SITE.description}>
  <section class="hero">
    <p class="eyebrow">{SITE.name}, healthcare interoperability specialist</p>
    <h1>Interoperability solutions for NHS hospitals, councils and clinics.</h1>
    <p>Tools for InterSystems IRIS, and the notes behind them.</p>
    <ul class="actions">
      <li><a class="btn primary" href="/projects/">See the projects</a></li>
      {
        SITE.calLink && (
          <li>
            <a class="btn ghost" href={bookingHref()} data-cal-link={SITE.calLink}>Book a meeting</a>
          </li>
        )
      }
      <li class="text-link"><a href="/about/">About me</a></li>
      <li class="text-link"><a href="/cv.pdf">CV (PDF)</a></li>
    </ul>
  </section>

  <section class="delivery" aria-labelledby="delivery-h">
    <h2 id="delivery-h">Selected delivery experience</h2>
    <ul>
      <li>Seven deployments of Blackford's clinical AI platform and its applications as sole engineer, in Italy, Germany, Norway and Poland.</li>
      <li>DocAssure, the document management framework I built on IRIS for Health, live at Sheffield Children's Hospital since April 2026.</li>
      <li>ePhlebotomy interfaces at Warrington and Halton: nearly 7,000 appointments booked in just over four months of the pilot.</li>
    </ul>
    <p><a href="/about/">More about my work <span aria-hidden="true">→</span></a></p>
  </section>

  <ul class="bento">
    {shown.map((p, i) => <ProjectTile project={p} span={3} tint={i % 2 ? 'b' : 'c'} />)}
    <li class={`tile tint-c ${reviews.length ? 'span-3' : 'span-6 band'}`}>
      <div class="glyph"><Icon name="book" /></div>
      <h2><a href="/knowledge/">Knowledge</a></h2>
      <p>The standards, platforms and NHS services I work with, and the notes behind the projects.</p>
    </li>
    {
      reviews.length > 0 && (
        <li class="tile tint-a span-3">
          <div class="glyph"><Icon name="star" /></div>
          <h2><a href="/reviews/">Reviews</a></h2>
          <p>Latest: {reviews[0].data.title}</p>
        </li>
      )
    }
  </ul>

  <section class="who" aria-label="Who made this site">
    <img src="/images/mikolaj-salata.jpg" alt="" width="120" height="120" />
    <p class="text"><strong>Made by {SITE.name}</strong>Healthcare interoperability specialist: HL7, FHIR and InterSystems IRIS for NHS hospitals, councils and clinics.</p>
    <ul class="links">
      {SITE.calLink && <li><a href={bookingHref()} data-cal-link={SITE.calLink}>Book a meeting</a></li>}
      <li><a href="/cv.pdf">CV (PDF)</a></li>
      <li><a href={SITE.linkedin} rel="me">LinkedIn</a></li>
      <li><a href={SITE.github} rel="me">GitHub</a></li>
    </ul>
  </section>
</Base>
