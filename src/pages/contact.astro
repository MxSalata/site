---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';
---

<Base title="Contact" description="How to get in touch with Mikolaj Salata.">
  <div class="page-head">
    <p class="eyebrow">Contact</p>
    <h1>Get in touch</h1>
    <p class="lead">For work, projects or anything on this site.</p>
  </div>
  <div class="paper">
    <ul class="contact">
      {
        SITE.booking && (
          <li>
            <a class="btn primary" href={SITE.booking}>Book a meeting</a>
            <span class="muted">Pick a time that suits you.</span>
          </li>
        )
      }
      <li>
        <span class="label">Email</span>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </li>
      <li>
        <span class="label">LinkedIn</span>
        <a href={SITE.linkedin} rel="me">linkedin.com/in/msalata</a>
      </li>
      <li>
        <span class="label">GitHub</span>
        <a href={SITE.github} rel="me">github.com/MxSalata</a>
      </li>
    </ul>
  </div>
</Base>
