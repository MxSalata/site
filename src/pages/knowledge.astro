---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { KNOWLEDGE } from '../data/knowledge';
import type { Group, Item, Level } from '../data/knowledge';
import { formatDate, writingHref } from '../lib/site';

const tints = ['a', 'b', 'c'] as const;
const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// The page's wording that is not in the data: what each level means. Change it here.
const MEANINGS: Record<Level | 'none', string> = {
  Deep: 'In-depth and hands-on: I work with it unaided and fix what breaks.',
  Working: 'Used on real projects.',
  Overview: 'Studied, used lightly.',
  none: 'Systems and regional records my interfaces were built against.',
};
const LEVELS: Level[] = ['Deep', 'Working', 'Overview'];
const METER: Record<Level, string> = { Deep: 'm3', Working: 'm2', Overview: 'm1' };
const WAFFLE: Record<Level | 'none', string> = { Deep: 'w-deep', Working: 'w-working', Overview: 'w-overview', none: 'w-none' };

// The map's six areas in reading order: specialisms, platforms, national services, standards, then the two bands.
// Each group takes the position class kb-z1 to kb-z6 by its place in this order, never by its title in the CSS. A group that
// is not named here goes last.
const ORDER = [
  'Specialisms',
  'Integration platforms',
  'NHS national services',
  'Standards',
  'Systems and care records I have integrated with',
  'Infrastructure and tools',
];
const rank = (g: Group) => {
  const at = ORDER.indexOf(g.title);
  return at === -1 ? ORDER.length : at;
};
const groups = [...KNOWLEDGE].sort((a, b) => rank(a) - rank(b));
const HUB = 1; // the platforms, where the interfaces run
const BANDS = [0, 4, 5]; // specialisms above the map; systems and care records, then infrastructure and tools, under it

// One icon per position (the inside of a 24 by 24 outline icon).
const ICONS = [
  '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/>',
  '<circle cx="12" cy="12" r="3"/><circle cx="5" cy="5" r="2"/><circle cx="19" cy="5" r="2"/><circle cx="5" cy="19" r="2"/><circle cx="19" cy="19" r="2"/><path d="M6.5 6.5l3 3M17.5 6.5l-3 3M6.5 17.5l3-3M17.5 17.5l-3-3"/>',
  '<path d="M3 21h18M5 21V10M9 21V10M15 21V10M19 21V10M2 10l10-6 10 6z"/>',
  '<path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5a2 2 0 0 0 2 2h1M16 3h1a2 2 0 0 1 2 2v5a2 2 0 0 0 2 2 2 2 0 0 0-2 2v5a2 2 0 0 1-2 2h-1"/>',
  '<rect x="3" y="4" width="18" height="6" rx="2"/><rect x="3" y="14" width="18" height="6" rx="2"/><path d="M7 7h.01M7 17h.01"/>',
  '<path d="M4 17l6-6-6-6"/><path d="M12 19h8"/>',
];
const ICON_CHART = '<path d="M3 3v18h18"/><path d="M7 16v-5"/><path d="M12 16V7"/><path d="M17 16v-3"/>';
const ICON_INFO = '<circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><path d="M12 8h.01"/>';
// Where a row has no level, an icon takes the pill's place: two-way arrows for the systems (connected to; a chain would
// read as a hyperlink, and these rows aren't links), layers for the records.
const ICON_CONNECT = '<path d="M8 3 4 7l4 4"/><path d="M4 7h16"/><path d="m16 21 4-4-4-4"/><path d="M20 17H4"/>';
const ICON_LAYERS = '<path d="M12 3l9 5-9 5-9-5z"/><path d="M3 13l9 5 9-5"/>';
const MARKS = [ICON_CONNECT, ICON_CONNECT, ICON_CONNECT, ICON_LAYERS, ICON_CONNECT, ICON_CONNECT];

// Everything below is computed from the data, so the page is complete with scripts off.
const allItems: Item[] = groups.flatMap((g) => g.items);
const total = allItems.length;
const byLevel = (l: Level | 'none') => allItems.filter((i) => (i.level ?? 'none') === l);
const legend = [...LEVELS, 'none' as const]
  .map((key) => ({ key, label: key === 'none' ? 'Integrated' : key, items: byLevel(key) }))
  .filter((l) => l.items.length > 0);
const plural = (n: number) => (n === 1 ? 'item' : 'items');
// The strip is decoration (aria-hidden), so one sentence says the same for a screen reader.
const summary = legend.map((l) => `${l.items.length} ${l.label}`).join(', ').replace(/, ([^,]*)$/, ' and $1') + '.';
---

<Base
  title="Knowledge"
  description="What healthcare interoperability specialist Mikolaj Salata knows in depth: HL7 v2, FHIR, DICOM, InterSystems, the Blackford Platform, NHS MESH and SPINE."
  mainClass="kb"
>
  <div class="page-head">
    <p class="eyebrow">Knowledge</p>
    <h1>Healthcare interoperability specialist</h1>
    <p class="lead">Six years of NHS HL7 v2 and FHIR on InterSystems IRIS, HealthShare and Ensemble; since April 2026, DICOM and clinical AI across Europe, as sole engineer on seven deployments.</p>
  </div>
  <section class="kb-glance" aria-labelledby="kb-h0">
    <div class="kb-gl">
      <div class="kb-zh">
        <span class="kb-glyph"
          ><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={ICON_CHART} /></span
        >
        <div><h2 id="kb-h0">At a glance</h2></div>
      </div>
      <div class="kb-glance-body">
        <div class="kb-total">
          <p class="kb-big"><span class="kb-num">{byLevel('Deep').length}</span> <span class="kb-big-label">Deep, of {total} items in {groups.length} areas</span></p>
          <div class="kb-waffle" aria-hidden="true">
            {legend.map((l) => l.items.map(() => <i class={WAFFLE[l.key]} />))}
          </div>
          <p class="kb-sr">{summary}</p>
        </div>
        <ul class="kb-legend" role="list">
          {
            legend.map((l) => (
              <li class="kb-leg">
                <div class="kb-leg-row">
                  <i class={`kb-sw ${WAFFLE[l.key]}`} aria-hidden="true" />
                  <span class="kb-leg-text">
                    <strong>{l.items.length} {l.label}</strong> <span>{MEANINGS[l.key]}</span>
                  </span>
                </div>
                <ul class="kb-names" role="list" aria-label={`${l.label} items`}>
                  {l.items.map((item, n) => (
                    <Fragment>
                      <li>{item.name}</li>
                      {n < l.items.length - 1 && ' '}
                    </Fragment>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
  <form class="kb-tools" role="search" aria-label="Find an item">
    <div class="kb-search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
      <label for="kb-q">Search</label>
      <input id="kb-q" type="search" placeholder="Try FHIR, DICOM or MESH" autocomplete="off" spellcheck="false" />
    </div>
    <div class="kb-seg" role="group" aria-label="Level">
      <button type="button" data-level="all" aria-pressed="true">All</button>
      <button type="button" data-level="Deep" aria-pressed="false">Deep</button>
      <button type="button" data-level="Working" aria-pressed="false">Working</button>
      <button type="button" data-level="Overview" aria-pressed="false">Overview</button>
      <button type="button" data-level="none" aria-pressed="false">Integrated</button>
    </div>
    <p class="kb-status" role="status" aria-live="polite" id="kb-status">{total} {plural(total)}</p>
  </form>
  <div class="kb-map" id="kb-map">
    {
      groups.map((g, i) => {
        const levelsHere = LEVELS.filter((l) => g.items.some((item) => item.level === l));
        return (
          <Fragment>
            <section class={`kb-zone kb-z${i + 1}${i === HUB ? ' kb-hub' : ''}${BANDS.includes(i) ? ' kb-band' : ''}`} data-group={g.title}>
              <div class="kb-zin">
                <div class="kb-zh">
                  <span class="kb-glyph"
                    ><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={ICONS[i] ?? ICONS[0]} /></span
                  >
                  <div class="kb-zt">
                    <h2 id={`kb-h${i + 1}`}>{g.title}</h2>
                    <p class="kb-intro">{g.intro}</p>
                    <p class="kb-tally">
                      <span class="kb-count">{g.items.length} {plural(g.items.length)}</span>
                      {
                        levelsHere.length > 0 && (
                          <span class="kb-lvs">
                            {levelsHere.map((l, n) => (
                              <Fragment>
                                <span class="kb-lv">
                                  <span class={`kb-meter ${METER[l]}`} aria-hidden="true"><i /><i /><i /></span>
                                  {l} {g.items.filter((item) => item.level === l).length}
                                </span>
                                {n < levelsHere.length - 1 && ', '}
                              </Fragment>
                            ))}
                          </span>
                        )
                      }
                    </p>
                  </div>
                </div>
                <ul class="kb-items" role="list" aria-labelledby={`kb-h${i + 1}`}>
                  {g.items.map((item) => (
                    <li class="kb-item" data-item={item.name} data-level={item.level}>
                      <span class="kb-name">{item.name}</span>
                      {item.level ? (
                        <span class="kb-level">
                          <span class="kb-sr">Level: </span>
                          <span class={`kb-meter ${METER[item.level]}`} aria-hidden="true"><i /><i /><i /></span>
                          {item.level}
                        </span>
                      ) : (
                        <span class="kb-mark" aria-hidden="true">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={MARKS[i] ?? ICON_CONNECT} />
                        </span>
                      )}
                      {item.note && <span class="kb-itnote">{item.note}</span>}
                    </li>
                  ))}
                </ul>
                {
                  g.note && (
                    <p class="kb-znote">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={ICON_INFO} />
                      <span>{g.note}</span>
                    </p>
                  )
                }
              </div>
            </section>
            {i < 3 && <div class={`kb-lane kb-l${i + 1}`} aria-hidden="true" />}
          </Fragment>
        );
      })
    }
    <div class="kb-drop kb-d1" aria-hidden="true" />
    <div class="kb-drop kb-d2" aria-hidden="true" />
    <div class="kb-drop kb-d3" aria-hidden="true" />
    <p class="kb-empty" id="kb-empty" hidden><button type="button" class="kb-link" id="kb-reset">Show all {total} items</button></p>
  </div>
  {
    posts.length > 0 && (
      <section>
        <h2 class="section-title">Articles</h2>
        <ul class="bento">
          {posts.map((w, i) => (
            <li class={`tile tint-${tints[i % 3]} span-3`}>
              <p class="meta">{formatDate(w.data.date)}{w.data.url && <Fragment> &middot; {new URL(w.data.url).hostname}</Fragment>}</p>
              <h2>
                <a href={writingHref(w)}>{w.data.title}</a>
              </h2>
              <p>{w.data.summary}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }
  <script is:inline src="/knowledge.js" defer></script>
</Base>
