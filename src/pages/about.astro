---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE, bookingHref } from '../lib/site';

const entry = await getEntry('pages', 'about');
const Content = entry ? (await render(entry)).Content : null;
---

<Base title={entry?.data.title ?? 'About'} description={entry?.data.description ?? SITE.description}>
  <div class="page-head">
    <p class="eyebrow">About</p>
    <div class="person">
      <img src="/images/mikolaj-salata.jpg" alt="" width="120" height="120" />
      <h1>{SITE.name}</h1>
    </div>
    <p class="lead">Healthcare integration engineer: HL7, FHIR and InterSystems IRIS for NHS hospitals.</p>
    <ul class="actions">
      <li><a class="btn primary" href="/cv.pdf">Download my CV</a></li>
      {SITE.calLink && <li><a class="btn ghost" href={bookingHref()} data-cal-link={SITE.calLink}>Book a meeting</a></li>}
    </ul>
  </div>
  <article class="paper">
    <div class="prose">
      {Content ? <Content /> : <p>More about me soon.</p>}
      <p class="more">
        More on <a href={SITE.linkedin} rel="me">LinkedIn</a>, or <a href="/contact/">get in touch</a>.
      </p>
    </div>
  </article>
</Base>
