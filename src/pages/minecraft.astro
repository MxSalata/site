---
import Base from '../layouts/Base.astro';
---

<Base title="Games" description="A small private Minecraft server for friends." noindex>
  <div class="page-head">
    <p class="eyebrow">Games</p>
    <h1>Games with friends</h1>
    <p class="lead">A small private Minecraft server for friends. It isn't open to the public.</p>
  </div>
  <article class="paper">
    <div class="prose">
      <h2>Joining</h2>
      <p>Access is by invitation. If you'd like to play, ask Mikolaj; he'll add you and send the details.</p>
      <h2>Rules</h2>
      <ul>
        <li>Be kind to the other players.</li>
        <li>Don't grief, steal or take apart other people's builds.</li>
        <li>No cheats, x-ray or client mods that give an advantage.</li>
        <li>Don't share the server's details with anyone else.</li>
      </ul>
    </div>
  </article>
</Base>
