---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { GAMES, STATUS, ACCESS } from '../data/games';
---

<Base title="Games" description="The game servers Mikolaj runs for friends: which are running, and how to join." noindex>
  <div class="page-head">
    <p class="eyebrow">Games</p>
    <h1>Games with friends</h1>
    <p class="lead">Private game servers for friends. They aren't open to the public.</p>
  </div>
  <script is:inline src="/games.js" defer></script>
  <!-- The tab list shows only with JavaScript, and /games.js works it; without JavaScript every game shows, one under another. -->
  <div class="gm-tabs" role="tablist" aria-label="Games">
    {
      GAMES.map((g, i) => (
        <button
          type="button"
          class="gm-tab"
          role="tab"
          id={`tab-${g.id}`}
          aria-controls={g.id}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? '0' : '-1'}
        >
          <span class="gm-name">{g.short}</span>
          {g.access && <Icon name={ACCESS[g.access].icon} label={ACCESS[g.access].label} />}
          <span class={`gm-status s-${g.status}`}>
            <span class="gm-dot" aria-hidden="true" />
            {STATUS[g.status]}
          </span>
        </button>
      ))
    }
  </div>
  {
    GAMES.map((g) => (
      <section class="paper gm-panel" id={g.id} aria-labelledby={`h-${g.id}`}>
        <div class="prose">
          <h2 id={`h-${g.id}`}>{g.name}</h2>
          <p class="gm-facts">
            <span class={`gm-status s-${g.status}`}>
              <span class="gm-dot" aria-hidden="true" />
              {STATUS[g.status]}
            </span>
            {g.access && (
              <span class="gm-lock">
                <Icon name={ACCESS[g.access].icon} />
                {ACCESS[g.access].label}
              </span>
            )}
          </p>
          <p>{g.description}</p>
          <h3>How to join</h3>
          <p>{g.join}</p>
        </div>
      </section>
    ))
  }
</Base>
